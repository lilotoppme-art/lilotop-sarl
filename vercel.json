{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin/nexus/reset-password",
      "destination": "/api/nexus-page?handler=admin-password-reset-page"
    },
    {
      "source": "/api/admin-password-reset",
      "destination": "/api/nexus-page?handler=admin-password-reset-api"
    },
    {
      "source": "/admin/nexus/crm",
      "destination": "/api/nexus-page?handler=crm-page"
    },
    {
      "source": "/api/crm",
      "destination": "/api/nexus-page?handler=crm-api"
    },
    {
      "source": "/api/resend-webhook",
      "destination": "/api/nexus-page?handler=resend-webhook"
    },
    {
      "source": "/api/email-delivery",
      "destination": "/api/nexus-page?handler=email-delivery-api"
    },
    {
      "source": "/api/nexus-gmail",
      "destination": "/api/nexus-page?handler=gmail-inbound-api"
    },
    {
      "source": "/api/nexus-gmail/callback",
      "destination": "/api/nexus-page?handler=gmail-inbound-api&action=callback"
    },
    {
      "source": "/admin/nexus/document-vault",
      "destination": "/api/nexus-page?handler=document-vault-page"
    },
    {
      "source": "/api/document-vault",
      "destination": "/api/nexus-page?handler=document-vault-api"
    },
    {
      "source": "/admin/nexus/orchestrator",
      "destination": "/api/nexus-page?handler=orchestrator-page"
    },
    {
      "source": "/api/nexus-orchestrator",
      "destination": "/api/nexus-page?handler=orchestrator-api"
    },
    {
      "source": "/admin/nexus/supplier-ai",
      "destination": "/api/nexus-page?handler=supplier-page"
    },
    {
      "source": "/api/supplier-ai",
      "destination": "/api/nexus-page?handler=supplier-api"
    },
    {
      "source": "/admin/nexus/tender-response-ai",
      "destination": "/api/nexus-page?handler=tender-response-page"
    },
    {
      "source": "/api/tender-response-ai",
      "destination": "/api/nexus-page?handler=tender-response-api"
    },
    {
      "source": "/admin/nexus/mining-watch",
      "destination": "/api/nexus-page?handler=mining-page"
    },
    {
      "source": "/api/mining-watch",
      "destination": "/api/nexus-page?handler=mining-api"
    },
    {
      "source": "/admin/nexus/tender-ai",
      "destination": "/api/nexus-page?handler=tender-page"
    },
    {
      "source": "/api/tender-ai",
      "destination": "/api/nexus-page?handler=tender-api"
    },
    {
      "source": "/admin/nexus/procurement-ai",
      "destination": "/api/procurement-ai-page"
    },
    {
      "source": "/admin/nexus/commercial-ai",
      "destination": "/api/commercial-ai-page"
    },
    {
      "source": "/admin/nexus",
      "destination": "/api/nexus-page"
    },
    {
      "source": "/admin/business-radar",
      "destination": "/api/business-radar-page"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-business-radar",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
